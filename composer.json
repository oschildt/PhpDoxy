{
  "name": "smartfactory/phpdoxy",
  "type": "project",
  "description": "Documentation Generator for PHP",
  "keywords": [
    "documentation",
    "generator"
  ],
  "bin": [
    "bin/phpdoxy"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Oleg Schildt",
      "email": "oleg.schildt@gmail.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "PhpDoxy\\": "src/PhpDoxy"
    },
    "files": [
      "src/echo_functions.php",
      "src/utils.php",
      "src/error_handling.php",
      "src/generate.php"
    ]
  },
  "require": {
    "php": ">=8.4",
    "ext-dom": "*",
    "ext-mbstring": "*",
    "ext-tokenizer": "*",
    "nikic/php-parser": "^5.9",
    "phpstan/phpdoc-parser": "^2.4",
    "phpdocumentor/reflection-docblock": "^6.0",
    "erusev/parsedown": "^1.8",
    "erusev/parsedown-extra": "^0.9"
  },
  "scripts": {
    "test": "@php tests/integration.php"
  }
}
