#!/usr/bin/env php
<?php

namespace PhpDoxy;

\ini_set("output_buffering", "off");
ob_implicit_flush();

$autoloaders = [
    $GLOBALS['_composer_autoload_path'] ?? '',
    __DIR__ . '/../vendor/autoload.php',
    __DIR__ . '/../../../autoload.php',
];

foreach ($autoloaders as $file) {
    if (is_file($file)) {
        require $file;

        exit(generate($argv));
    }
}

fwrite(STDERR, "PhpDoxy's Composer autoloader could not be found.\n");

exit(1);
